# Шаблон переменных окружения для docker-compose.
# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env
# Без .env используются значения по умолчанию (как ниже). Файл .env в git не коммитится.

# PostgreSQL (одинаковые учётные данные для трёх отдельных экземпляров БД)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=shophub
RABBITMQ_PASSWORD=change-me

# Порты сервисов на хосте
CATALOG_PORT=5002
ORDER_PORT=5004
NOTIFICATION_PORT=5006
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025

# Email: Smtp — отправка через SMTP (по умолчанию Mailpit), Fake — только запись в лог
EMAIL_PROVIDER=Smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@shophub.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
